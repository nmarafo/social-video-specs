  "prompts": [
    { "id": "prompt-maestro", "path": "plantillas/prompts/prompt_maestro_editor_video_rrss.md" },
    { "id": "prompt-01-analisis", "path": "plantillas/prompts/prompt_01_analisis_formato_plataforma.md" },
    { "id": "prompt-02-ritmo", "path": "plantillas/prompts/prompt_02_ritmo_y_storyboarding.md" },
    { "id": "prompt-03-subtitulos", "path": "plantillas/prompts/prompt_03_generacion_subtitulos_safe_zones.md" },
